# Build output
build/
build-*/
out/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.pdb
*.ilk
*.exp
*.idb

# Qt / CMake generated
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
ui_*.cpp
.qmake.stash
Makefile
Makefile.*
CMakeLists.txt.user
CMakeSettings.json
*.pro.user
*.pro.user.*
!*.pro.user.template
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json

# Qt / IDE settings
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.ntvs*
*.njsproj
*.sln.docstates
*.VC.db
*.VC.opendb
*.qmlc
*.jsc

# Compressed codec output (.nam)
*.nam
# ...but reference test vectors are versioned on purpose.
!tests/vectors/*.nam

# Compressed codec output (.bcc)
*.bcc
# ...but reference test vectors are versioned on purpose.
!tests/vectors/*.bcc

# Sample / scratch output
result.nam
compressed.nam
result.bcc
compressed.bcc
*.bmp.tmp
desktop.ini
Thumbs.db
.DS_Store
$RECYCLE.BIN/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.old
*~

# Python / tooling caches (used by the vector-generation script)
__pycache__/
*.pyc
.pytest_cache/

# CLion's default build directory name
cmake-build-debug/
cmake-build-*/
# Locally built binaries
/*.exe
/build*/**/*.exe

# Visual Studio output, in case legacy/vs-console/ is opened and built
# in place. The .vcxproj is versioned; its build products are not.
/legacy/vs-console/Debug/
/legacy/vs-console/Release/
/legacy/vs-console/x64/
/legacy/vs-console/*.exe

# Benchmark output. The tables are measured again for the release notes, so
# the files of a local run are not versioned.
/bench.csv
/bench_jpeg.csv
/bench_matched.csv
/bench_output.txt
/bench_test*.csv
/bench_test*.txt
