@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The public headers of blockcodec include <opencv2/core.hpp>, so a consumer
# needs the OpenCV headers as well as the library itself. The OpenCV package
# also defines the imported targets that the exported blockcodec target links
# against, so this has to come before the targets file is included.
find_dependency(OpenCV)

include("${CMAKE_CURRENT_LIST_DIR}/blockcodecTargets.cmake")

check_required_components(blockcodec)
